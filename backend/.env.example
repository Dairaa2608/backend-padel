# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env a Git.

# Cadena de conexión de MongoDB Atlas (Atlas → Connect → Drivers).
# Sustituye <usuario> y <contraseña> por el usuario de base de datos que creaste en Atlas.
# "padelzone" (antes del "?") es el nombre de la base de datos.
MONGODB_URI="mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/padelzone?retryWrites=true&w=majority"

# Usuario administrador que crea el seed
SEED_ADMIN_EMAIL="admin@padelzone.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123"

# Puerto donde escucha la API
PORT=3000

# Dirección del frontend (React) que puede usar la API
CLIENT_URL="http://localhost:5173"

# Clave secreta para firmar los tokens de sesión (genera una larga y aleatoria)
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Clave secreta para proteger las cédulas de la clase de cortesía (genera una larga y aleatoria).
# No la cambies después de usarla: las cédulas ya guardadas dejarían de reconocerse.
CEDULA_SECRET="cambia-esto-por-otra-clave-larga-y-aleatoria"

# Correo de bienvenida (opcional). Cuenta de Gmail que envía los correos.
# MAIL_PASS es una "contraseña de aplicación" de Google (16 letras), NO la contraseña del correo.
# Se crea en https://myaccount.google.com/apppasswords (la cuenta necesita la verificación en 2 pasos).
# Si se dejan vacías, los correos van a un buzón de PRUEBA (Ethereal): no llegan a ninguna bandeja,
# pero en la consola de la API aparece un enlace para ver cada correo en el navegador.
MAIL_USER=""
MAIL_PASS=""

# Asistente conversacional gratis mediante OpenRouter (la clave solo se usa en el backend).
# Crea una clave en https://openrouter.ai/settings/keys.
# Se usa openrouter/free, que selecciona modelos gratuitos y no recurre a modelos de pago.
OPENROUTER_API_KEY=""

# Mensaje de bienvenida al celular (opcional), con Twilio: https://www.twilio.com
# Los datos están en la consola de Twilio (Account Info). TWILIO_FROM es el número que te da Twilio.
# SMS_CHANNEL: "sms" (por defecto) o "whatsapp" (para WhatsApp usa el número del Sandbox de WhatsApp).
# Si se dejan vacías, el mensaje solo se muestra en la consola de la API.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
SMS_CHANNEL="sms"
