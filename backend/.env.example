# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env a Git.

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://padel:padel@localhost:5432/padelzone?schema=public"

# Contraseña del usuario administrador que crea el seed
SEED_ADMIN_EMAIL="admin@padelzone.com"
