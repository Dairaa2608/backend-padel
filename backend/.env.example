# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env a Git.

# Cadena de conexión de MongoDB Atlas (Atlas → Connect → Drivers).
# Sustituye <usuario> y <contraseña> por el usuario de base de datos que creaste en Atlas.
# "padelzone" (antes del "?") es el nombre de la base de datos.
MONGODB_URI="mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/padelzone?retryWrites=true&w=majority"

# Usuario administrador que crea el seed
SEED_ADMIN_EMAIL="admin@padelzone.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123"
